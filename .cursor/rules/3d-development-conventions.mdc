  console.log('Animation actions:', actions);
  console.log('Mixer state:', mixer.current);
}
```

### 애니메이션 디버깅
```typescript
// 애니메이션 상태 확인
useEffect(() => {
  console.log('Available animations:', animations.map(a => a.name));
  console.log('Actions:', Object.keys(actions));
}, [animations, actions]);
```

